# Your Gemini API Key from Google AI Studio or Vertex AI
GEMINI_API_KEY="your_api_key_here"

# The Google Cloud Storage bucket name for saving generated images and audio
GCS_BUCKET_NAME="storybook-assets-dev"

# The path to your Google Cloud Service Account JSON key file
# This is required for Firestore and Cloud Storage to authenticate automatically
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/your/service-account-key.json"

# (Optional) The Google Cloud Project ID
GOOGLE_CLOUD_PROJECT="your-google-cloud-project-id"